# MongoDB
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE
MONGODB_DB=portfolio

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters

# Used only by `npm run create-admin`; do not expose these as NEXT_PUBLIC_ variables.
ADMIN_NAME=Raihan Miraj
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional future media provider. The current Editor.js setup supports URL-based images.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
